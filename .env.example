# Copiá este archivo a .env y ajustá los valores según tu entorno.
# cp .env.example .env

# Nivel de logging del paquete voice_assistant.
LOG_LEVEL=DEBUG

# --- Wake word ---
# Motor de detección. Determina qué variables de abajo se usan.
#   openwakeword -> modelos preentrenados o .tflite de openwakeword
#   heed         -> modelo custom entrenado con heed (ver docs/wake-word-training.md)
WAKE_WORD_ENGINE=openwakeword

# WAKE_WORD_MODEL: ruta/nombre del modelo. Su valor depende del motor activo:
#   openwakeword -> nombre preentrenado (alexa, hey_jarvis, ...) o ruta a .tflite
#   heed         -> ruta al .onnx exportado: models/wake.onnx (x86) o
#                   models/wake.int8.onnx (ARM/Raspberry)
WAKE_WORD_MODEL=alexa

# Opciones del motor "openwakeword":
# Nombre de la wake word (key que devuelve el modelo; para .tflite custom, el
# nombre del archivo sin extensión).
WAKE_WORD_NAME=alexa
# Framework de inferencia: "tflite" u "onnx" (openwakeword no lo deduce solo).
WAKE_WORD_INFERENCE_FRAMEWORK=tflite
# Umbral de confianza (0.0 - 1.0). Más alto = menos falsos positivos.
WAKE_WORD_THRESHOLD=0.5

# Opciones del motor "heed":
# Contrato de preprocesado del modelo. El threshold vive dentro del wake.json.
WAKE_WORD_METADATA=models/wake.json
