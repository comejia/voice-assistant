# Copiá este archivo a .env y ajustá los valores según tu entorno.
# cp .env.example .env

# Nivel de logging del paquete voice_assistant.
LOG_LEVEL=DEBUG

# --- Wake word ---
# Modelo a usar: un nombre preentrenado de openwakeword (alexa, hey_jarvis,
# hey_mycroft, ...) o la ruta a un .tflite custom (p. ej. models/hola_deby.tflite).
WAKE_WORD_MODEL=alexa
# Nombre de la wake word: debe coincidir con la key que devuelve el modelo.
# Para un modelo custom es el nombre del archivo sin extensión (p. ej. hola_deby).
WAKE_WORD_NAME=alexa
# Framework de inferencia según el formato del modelo: "tflite" o "onnx".
# openwakeword NO lo deduce de la extensión; con un .onnx hay que poner "onnx".
WAKE_WORD_INFERENCE_FRAMEWORK=tflite
# Umbral de confianza para activar (0.0 - 1.0). Más alto = menos falsos positivos.
WAKE_WORD_THRESHOLD=0.5
