# Copiá este archivo a .env y ajustá los valores según tu entorno.
# cp .env.example .env

# Nivel de logging del paquete voice_assistant.
LOG_LEVEL=DEBUG

# --- Wake word ---
# Motor de detección. Determina qué variables de abajo se usan.
#   openwakeword -> modelos preentrenados o .tflite de openwakeword
#   heed         -> modelo custom entrenado con heed (ver docs/wake-word-training.md)
WAKE_WORD_ENGINE=openwakeword

# WAKE_WORD_MODEL: ruta/nombre del modelo. Su valor depende del motor activo:
#   openwakeword -> nombre preentrenado (alexa, hey_jarvis, ...) o ruta a .tflite
#   heed         -> ruta al .onnx exportado: models/wake.onnx (x86) o
#                   models/wake.int8.onnx (ARM/Raspberry)
WAKE_WORD_MODEL=alexa

# Opciones del motor "openwakeword":
# Nombre de la wake word (key que devuelve el modelo; para .tflite custom, el
# nombre del archivo sin extensión).
WAKE_WORD_NAME=alexa
# Framework de inferencia: "tflite" u "onnx" (openwakeword no lo deduce solo).
WAKE_WORD_INFERENCE_FRAMEWORK=tflite
# Umbral de confianza (0.0 - 1.0). Más alto = menos falsos positivos.
WAKE_WORD_THRESHOLD=0.5

# Opciones del motor "heed":
# Contrato de preprocesado del modelo (incluye el threshold calibrado).
WAKE_WORD_METADATA=models/wake.json
# Las siguientes son OPCIONALES en heed; si se omiten, mandan los valores del
# wake.json:
#   WAKE_WORD_THRESHOLD -> sobrescribe el threshold del modelo.
#   WAKE_WORD_NAME      -> frase esperada; si no coincide con la del modelo,
#                          el asistente no arranca (verificación).

# --- Speech-to-Text (faster-whisper) ---
# Modelo Whisper: tiny, base, small, medium, large-v3. A mayor tamaño, mejor
# calidad y más lento. 'tiny' es el más liviano; buen punto de partida en CPU.
STT_MODEL=tiny
# Dispositivo de inferencia: cpu, cuda (GPU NVIDIA) o auto.
STT_DEVICE=cpu
# Precisión numérica. En CPU se recomienda 'int8' (rápido y liviano).
# Otras: int8_float16, float16, float32.
STT_COMPUTE_TYPE=int8
# Directorio donde faster-whisper descarga y cachea el modelo.
STT_DOWNLOAD_ROOT=models/whisper
# Idioma de la transcripción (es, en, ...). Vacío = detección automática.
STT_LANGUAGE=es
# Segundos de audio a capturar tras la wake word para el comando del usuario.
STT_COMMAND_SECONDS=5
